{
  "name": "mfs",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:wasm": "wasm-pack build wasm/mfs-core --target web --out-dir ../../src/wasm/pkg --release",
    "build": "npm run build:wasm && tsc -b && vite build",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "latest",
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "wrangler": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest"
  }
}
